# Copy to .env (git-ignored) or export. Secrets never go in files in plaintext:
# the master key comes from the environment or a mounted secret file.

MASTER_KEY_FILE=/run/secrets/agentwallet_master_key   # or MASTER_KEY=<base64 32 bytes>; `agentwallet init` generates one
KEYSTORE_FILE=./data/keystore.enc                    # sealed: relayer pool + SEP-10 key (created by `agentwallet init`)
DB_FILE=./data/agentwallet.db                        # users, agents (keys sealed), API keys + sessions (hashed), payments

PUBLIC_URL=http://localhost:8090                     # its host is the SEP-10 home/web-auth domain; https => Secure cookies
LISTEN=:8090
TRUST_PROXY=false                                    # true only behind a reverse proxy (client IP from X-Forwarded-For)

LLM_API_KEY=                                         # enables the chat (any OpenAI-compatible API)
LLM_BASE_URL=https://openrouter.ai/api/v1             # e.g. OpenRouter, or your own gateway (…/v1)
MODEL=openai/gpt-4o-mini
APPROVAL_THRESHOLD=2                                 # USDC; larger payments wait for the user's approval
RECORD_REJECTIONS=true                               # submit over-limit payments anyway so the rejection has a tx hash
RELAYERS=3                                           # channel accounts created by `agentwallet init`
DEV_WALLET=false                                     # tests only: in-browser test keys + friendbot endpoint

# Abuse limits (0 disables one). Daily counters are per UTC day and stored in the db.
# CHAT_DAILY_PER_WALLET=50          # chat messages per wallet per day
# CHAT_DAILY_PER_IP=150             # chat messages per IP per day
# LLM_DAILY_CALLS=5000              # model calls per day for the whole service (chat pauses, MCP keeps working)
# CHAT_MAX_CHARS=4000               # characters per chat message
# CHAT_HISTORY_MESSAGES=30          # latest messages sent to the model per turn
# LLM_MAX_TOKENS=1024               # max_tokens per model reply
# CHAT_CONCURRENT_PER_WALLET=3      # chat answers streaming at once per wallet
# MCP_CALLS_PER_MINUTE=120          # tool calls per agent per minute (MCP and chat)
# OWNER_OPS_PER_HOUR=30             # prepared wallet operations per wallet per hour
# PENDING_OPS_PER_USER=20           # unsigned operations per wallet
# DEPLOYS_PER_IP_DAY=10             # new agent wallets per IP per day
# AGENTS_PER_USER=10
# KEYS_PER_AGENT=5                  # active API keys per agent

# Shared contracts (default: ../deployments/testnet.json from the parent repo)
# DEPLOYMENT_FILE=/abs/path/testnet.json
# VERIFIER=C...  SPENDING_LIMIT_POLICY=C...  USDC_SAC=C...  ACCOUNT_WASM_HASH=<hex>
# RPC_URL=https://soroban-testnet.stellar.org
