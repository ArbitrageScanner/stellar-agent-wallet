# Automatic HTTPS for the public hostname. The chat streams SSE: no buffering.
{$DOMAIN} {
	@compressible not path /api/chat*
	encode @compressible zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy agentwallet:8090 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}
}
